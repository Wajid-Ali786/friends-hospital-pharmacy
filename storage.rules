rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validMedicineImage() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Current medicine image: users/{uid}/medicines/{medicineId}.png
    match /users/{userId}/medicines/{imageFile} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && validMedicineImage();
    }
    // Packing images: users/{uid}/medicines/{medicineId}/packagings/{packingId}.png
    match /users/{userId}/medicines/{medicineId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && validMedicineImage();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}